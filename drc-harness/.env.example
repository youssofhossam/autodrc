# Copy this file to .env and fill in real values.
# Never commit .env.

# Required: your Google AI Studio API key.
GEMINI_API_KEY=your_api_key_here

# Required: the Gemini model that supports function calling.
GEMINI_MODEL=gemini-2.5-flash

# Optional: system instruction sent with every request.
# GEMINI_SYSTEM_INSTRUCTION=You are a helpful assistant.

# Optional: sampling temperature (0.0 - 2.0).
# GEMINI_TEMPERATURE=0.2

# Optional: maximum number of Gemini requests in one agentic turn.
MAX_TOOL_ITERATIONS=8

# Optional: truncate very large MCP results before sending them to Gemini.
MAX_TOOL_RESULT_CHARS=20000

# Optional: ask for confirmation before every MCP tool call.
# Tool descriptions come from an external server, so "true" is the safe default.
MCP_CONFIRM_TOOL_CALLS=true

# Optional: path to the MCP server configuration file.
MCP_CONFIG_PATH=mcp_servers.json

# Optional: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
