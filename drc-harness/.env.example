# Copy this file to .env and fill in real values.
# Never commit .env.

# Which model provider to use: gemini (default) or openrouter.
LLM_PROVIDER=gemini

# --- Google Gemini (used when LLM_PROVIDER=gemini) ---

# Required: your Google AI Studio API key.
GEMINI_API_KEY=your_api_key_here

# Required: the Gemini model that supports function calling.
GEMINI_MODEL=gemini-2.5-flash

# --- OpenRouter (used when LLM_PROVIDER=openrouter) ---

# Required: create a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Required: the OpenRouter model ID. It must support tool calling.
# OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional: override the API endpoint.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: attribution headers sent to OpenRouter.
# OPENROUTER_SITE_URL=https://example.com
# OPENROUTER_APP_NAME=autodrc

# --- Shared settings ---

# Optional: system instruction sent with every request.
# LLM_SYSTEM_INSTRUCTION=You are a helpful assistant.

# Optional: sampling temperature (0.0 - 2.0). Falls back to
# GEMINI_TEMPERATURE or OPENROUTER_TEMPERATURE when unset.
# LLM_TEMPERATURE=0.2

# Optional: maximum number of model requests in one agentic turn.
# When the budget runs out, the GUI asks whether to continue.
MAX_TOOL_ITERATIONS=1000

# Optional: truncate very large MCP results before sending them to the model.
MAX_TOOL_RESULT_CHARS=20000

# Optional: ask for confirmation before every MCP tool call.
# Tool descriptions come from an external server, so "true" is the safe default.
MCP_CONFIRM_TOOL_CALLS=true

# Optional: path to the MCP server configuration file.
MCP_CONFIG_PATH=mcp_servers.json

# Optional: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
